<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BitGetPay - TRC20 USDT Payment Portal</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .container { width: 100%; max-width: 480px; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border: 1px solid #334155; }
        h2 { text-align: center; color: #38bdf8; margin-bottom: 20px; }
        .success { color: #22c55e; background: rgba(34, 197, 94, 0.1); padding: 12px; border-radius: 6px; text-align: center; margin-bottom: 20px; font-weight: 600; border: 1px solid rgba(34, 197, 94, 0.2); }
        p { color: #94a3b8; font-size: 14px; margin-bottom: 8px; }
        .wallet-box { background: #0f172a; padding: 12px; word-break: break-all; font-family: monospace; color: #38bdf8; border: 1px dashed #38bdf8; border-radius: 6px; margin-bottom: 20px; font-size: 13px; text-align: center; }
        label { display: block; margin-top: 15px; font-size: 13px; font-weight: 600; color: #cbd5e1; }
        input[type="text"], input[type="file"] { width: 100%; padding: 12px; margin-top: 6px; background: #0f172a; border: 1px solid #334155; color: white; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
        input[type="file"] { padding: 8px; cursor: pointer; }
        button { width: 100%; padding: 12px; margin-top: 25px; background: #2563eb; color: white; border: none; cursor: pointer; font-size: 16px; font-weight: bold; border-radius: 6px; transition: background 0.2s; }
        button:hover { background: #1d4ed8; }
        .admin-link { text-align: center; margin-top: 20px; font-size: 13px; }
        .admin-link a { color: #38bdf8; text-decoration: none; }
        .admin-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="container">
        <h2>BitGetPay Deposit</h2>
        <% if (success) { %>
            <div class="success">Payment submitted successfully! Waiting for admin verification.</div>
        <% } %>
        
        <p>Send USDT (TRC20) to the deposit address below:</p>
        <div class="wallet-box"><%= wallet %></div>

        <form action="/submit-payment" method="POST" enctype="multipart/form-data">
            <label>Your Name / Username:</label>
            <input type="text" name="username" placeholder="Enter your username" required>

            <label>Amount Sent (USDT):</label>
            <input type="text" name="amount" placeholder="e.g. 100" required>

            <label>Transaction Hash (TxID):</label>
            <input type="text" name="txid" placeholder="Enter TRC20 transaction hash" required>

            <label>Upload Payment Proof (Screenshot):</label>
            <input type="file" name="screenshot" accept="image/*" required>

            <button type="submit">Submit Payment</button>
        </form>

        <div class="admin-link">
            <a href="/admin-login" target="_blank">Admin Panel Login</a>
        </div>
    </div>
</body>
</html>
