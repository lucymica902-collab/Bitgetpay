<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>BitGetPay - Admin Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto 20px auto; background: #1e293b; padding: 15px 25px; border-radius: 8px; border: 1px solid #334155; }
        h2 { color: #38bdf8; margin: 0; }
        .logout-btn { background: #ef4444; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: bold; }
        .logout-btn:hover { background: #dc2626; }
        .table-container { max-width: 1200px; margin: 0 auto; background: #1e293b; border-radius: 8px; border: 1px solid #334155; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 14px 16px; border-bottom: 1px solid #334155; font-size: 14px; }
        th { background: #0f172a; color: #38bdf8; font-weight: 600; }
        tr:hover { background: rgba(255,255,255,0.02); }
        img { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #475569; cursor: pointer; }
        .btn-approve { background: #22c55e; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; font-weight: bold; font-size: 12px; }
        .btn-reject { background: #ef4444; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; font-weight: bold; font-size: 12px; margin-left: 5px; }
        .status-approved { color: #22c55e; font-weight: bold; }
        .status-rejected { color: #ef4444; font-weight: bold; }
        .status-pending { color: #f59e0b; font-weight: bold; }
        .empty { text-align: center; color: #94a3b8; padding: 30px; }
    </style>
</head>
<body>
    <div class="header">
        <h2>BitGetPay Admin Dashboard</h2>
        <a href="/admin-logout" class="logout-btn">Logout</a>
    </div>

    <div class="table-container">
        <table>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Amount</th>
                <th>TxID</th>
                <th>Screenshot</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
            <% if (transactions.length === 0) { %>
                <tr><td colspan="8" class="empty">No transactions found.</td></tr>
            <% } else { %>
                <% transactions.forEach(tx => { %>
                    <tr>
                        <td>#<%= tx.id %></td>
                        <td><%= tx.username %></td>
                        <td><b><%= tx.amount %> USDT</b></td>
                        <td style="font-family: monospace; max-width: 150px; word-break: break-all;"><%= tx.txid %></td>
                        <td><a href="/uploads/<%= tx.screenshot %>" target="_blank"><img src="/uploads/<%= tx.screenshot %>" alt="Proof"></a></td>
                        <td>
                            <span class="<%= tx.status === 'Approved & Verified' ? 'status-approved' : (tx.status === 'Rejected' ? 'status-rejected' : 'status-pending') %>">
                                <%= tx.status %>
                            </span>
                        </td>
                        <td><small><%= tx.date %></small></td>
                        <td>
                            <% if (tx.status === 'Pending') { %>
                                <form action="/admin/verify/<%= tx.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-approve">Approve</button>
                                </form>
                                <form action="/admin/reject/<%= tx.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-reject">Reject</button>
                                </form>
                            <% } else { %>
                                <em>Completed</em>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </table>
    </div>
</body>
</html>
