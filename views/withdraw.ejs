<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdrawal & Bank Cards - Bitget</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding: 20px; }
        .card { background: #1f1f1f; padding: 20px; border-radius: 8px; border: 1px solid #333; max-width: 450px; margin: auto; margin-bottom: 20px; }
        input, select { padding: 12px; margin: 8px 0 15px 0; width: 100%; border: 1px solid #444; border-radius: 6px; box-sizing: border-box; background: #2a2a2a; color: white; }
        button { width: 100%; padding: 12px; background: #f0b90b; color: black; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 16px; }
        .back { display: block; text-align: center; margin-top: 15px; color: #00ffcc; text-decoration: none; }
        .alert { padding: 10px; margin-bottom: 15px; border-radius: 5px; text-align: center; font-size: 14px; }
        .success { background: #004d26; color: #00ffcc; }
        .error { background: #4d0000; color: #ff4d4d; }
    </style>
</head>
<body>

    <div class="card">
        <h2>Withdrawal Dashboard</h2>
        <p style="color: #aaa; font-size: 14px;">Available Balance: <b style="color: #00ffcc;"><%= user.balance.toFixed(2) %> USDT</b></p>

        <% if (success === 'true') { %>
            <div class="alert success">Withdrawal request submitted successfully!</div>
        <% } else if (success === 'bank') { %>
            <div class="alert success">Bank/UPI details saved successfully!</div>
        <% } %>
        <% if (error === 'true') { %>
            <div class="alert error">Insufficient balance or invalid amount!</div>
        <% } %>

        <h3>1. Bind Bank Card / UPI</h3>
        <form action="/save-bank" method="POST">
            <input type="text" name="fullname" placeholder="Full Name (as per bank)" value="<%= user.bank_details ? user.bank_details.fullname : '' %>" required>
            <input type="text" name="bank_name" placeholder="Bank Name / Paytm / PhonePe" value="<%= user.bank_details ? user.bank_details.bank_name : '' %>" required>
            <input type="text" name="account_no" placeholder="Account Number / UPI ID" value="<%= user.bank_details ? user.bank_details.account_no : '' %>" required>
            <button type="submit" style="background: #22c55e; color: white;">Save / Update Bank Card</button>
        </form>
    </div>

    <div class="card">
        <h3>2. Request Withdrawal</h3>
        <form action="/submit-withdraw" method="POST">
            <label><b>Withdrawal Method</b></label>
            <select name="method" required>
                <option value="Bank / UPI">Bank Card / UPI</option>
                <option value="USDT TRC20">USDT (TRC20 Wallet)</option>
            </select>

            <label><b>Destination (Account No / UPI / TRC20 Address)</b></label>
            <input type="text" name="details" placeholder="Enter Account No, UPI or TRC20 Address" required>

            <label><b>Amount (USDT)</b></label>
            <input type="number" step="0.01" name="amount" placeholder="Enter amount to withdraw" required>

            <button type="submit">Submit Withdrawal</button>
        </form>

        <a href="/" class="back">Back to Dashboard</a>
    </div>

</body>
</html>
