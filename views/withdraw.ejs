<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdrawal - Bitgetpay</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding: 20px; }
        .card { background: #1e1e1e; padding: 20px; border-radius: 12px; border: 1px solid #333; max-width: 500px; margin: auto; margin-bottom: 20px; }
        input, select { padding: 12px; margin: 8px 0; width: 100%; border: 1px solid #444; border-radius: 8px; box-sizing: border-box; background: #2a2a2a; color: white; }
        button { width: 100%; padding: 12px; background: #eab308; color: black; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 16px; margin-top: 10px; }
        .back { display: block; text-align: center; margin-top: 15px; color: #eab308; text-decoration: none; }
        .alert { padding: 10px; margin-bottom: 15px; border-radius: 5px; text-align: center; font-size: 14px; }
        .success { background: #065f46; color: #34d399; }
        .error { background: #991b1b; color: #f87171; }
        .saved-details { background: #2c2c2c; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #eab308; }
        .saved-details h3 { margin-top: 0; color: #eab308; font-size: 16px; }
        .history-item { background: #262626; padding: 12px; border-radius: 8px; margin-bottom: 10px; font-size: 14px; border: 1px solid #383838; }
    </style>
</head>
<body>

    <div class="card">
        <h2 style="text-align: center; color: #eab308;">Payout Details Setup</h2>
        
        <% if (success === 'bank') { %>
            <div class="alert success">Payout details saved successfully!</div>
        <% } %>

        <!-- User ki khud ki saved details yahan dikhengi -->
        <% if (user.bank_details && (user.bank_details.account_no || user.bank_details.upi_id || user.bank_details.qr_image)) { %>
            <div class="saved-details">
                <h3>Your Saved Withdrawal Details:</h3>
                <% if(user.bank_details.fullname) { %><strong>Full Name:</strong> <%= user.bank_details.fullname %><br><% } %>
                <% if(user.bank_details.bank_name) { %><strong>Bank Name:</strong> <%= user.bank_details.bank_name %><br><% } %>
                <% if(user.bank_details.account_no) { %><strong>Account No:</strong> <%= user.bank_details.account_no %><br><% } %>
                <% if(user.bank_details.ifsc) { %><strong>IFSC Code:</strong> <%= user.bank_details.ifsc %><br><% } %>
                <% if(user.bank_details.upi_id) { %><strong>UPI ID:</strong> <%= user.bank_details.upi_id %><br><% } %>
                <% if(user.bank_details.qr_image) { %>
                    <strong>Uploaded QR Code:</strong><br>
                    <img src="<%= user.bank_details.qr_image %>" alt="Saved QR" style="max-width: 120px; margin-top: 5px; border-radius: 6px; border: 1px solid #555;"><br>
                <% } %>
                <p style="font-size: 12px; color: #aaa; margin-top: 8px; margin-bottom: 0;">*Nayi details ya QR upload karke save karne par purani wali automatically update ho jayengi.</p>
            </div>
        <% } %>

        <form action="/save-bank" method="POST">
            <h3 style="color: #38bdf8; font-size: 15px; margin-bottom: 5px;">1. Bank Account Card Details</h3>
            <label>Full Name</label>
            <input type="text" name="fullname" value="<%= user.bank_details ? user.bank_details.fullname : '' %>" placeholder="Enter Full Name">

            <label>Bank Name</label>
            <input type="text" name="bank_name" value="<%= user.bank_details ? user.bank_details.bank_name : '' %>" placeholder="Enter Bank Name">

            <label>Account Number</label>
            <input type="text" name="account_no" value="<%= user.bank_details ? user.bank_details.account_no : '' %>" placeholder="Enter Account Number">

            <label>IFSC Code</label>
            <input type="text" name="ifsc" value="<%= user.bank_details ? user.bank_details.ifsc : '' %>" placeholder="Enter IFSC Code">

            <hr style="border: 0; border-top: 1px solid #444; margin: 20px 0;">

            <h3 style="color: #38bdf8; font-size: 15px; margin-bottom: 5px;">2. UPI ID Option</h3>
            <label>UPI ID</label>
            <input type="text" name="upi_id" value="<%= user.bank_details ? user.bank_details.upi_id : '' %>" placeholder="Enter UPI ID (e.g. user@paytm)">

            <hr style="border: 0; border-top: 1px solid #444; margin: 20px 0;">

            <h3 style="color: #38bdf8; font-size: 15px; margin-bottom: 5px;">3. UPI / Digital QR Code Upload</h3>
            <label>Select QR Image from Device</label>
            <input type="file" accept="image/*" onchange="encodeImageFileAsURL(this)" style="padding: 10px;">
            <input type="hidden" name="qr_image" id="qr_image_input" value="<%= user.bank_details ? user.bank_details.qr_image : '' %>">

            <button type="submit">Save / Update All Details</button>
        </form>
    </div>

    <div class="card">
        <h2 style="text-align: center; color: #eab308;">Request Withdrawal</h2>
        <p style="text-align: center;">Available Balance: <strong>₹<%= user.balance.toFixed(2) %></strong></p>

        <% if (success === 'true') { %>
            <div class="alert success">Withdrawal request submitted successfully!</div>
        <% } %>
        <% if (error === 'true') { %>
            <div class="alert error">Insufficient balance or invalid details!</div>
        <% } %>

        <form action="/submit-withdraw" method="POST">
            <label>Amount (₹)</label>
            <input type="number" step="0.01" name="amount" placeholder="Enter withdrawal amount" required>

            <label>Select Payout Method</label>
            <select name="method" required>
                <option value="Bank Card">Bank Card</option>
                <option value="UPI ID">UPI ID</option>
                <option value="UPI / Digital QR">UPI / Digital QR</option>
            </select>

            <label>Confirm Target Details</label>
            <input type="text" name="details" placeholder="Re-enter your Account No or UPI ID" required>

            <button type="submit" style="background: #10b981; color: white;">Withdraw Now</button>
        </form>
    </div>

    <div class="card">
        <h3 style="color: #eab308; margin-top: 0;">Withdrawal History</h3>
        <% if (user.withdraw_history && user.withdraw_history.length > 0) { %>
            <% user.withdraw_history.forEach(item => { %>
                <div class="history-item">
                    <strong>₹<%= item.amount %></strong> (<%= item.method %>)<br>
                    <small>Details: <%= item.details %></small><br>
                    <small>Date: <%= item.date %></small><br>
                    Status: <span style="color: <%= item.status === 'Approved' ? '#34d399' : item.status === 'Rejected' ? '#f87171' : '#facc15' %>;"><%= item.status %></span>
                </div>
            <% }) %>
        <% } else { %>
            <p style="text-align: center; color: #888; font-size: 14px;">No withdrawal history found.</p>
        <% } %>
        
        <a href="/" class="back">← Back to Dashboard</a>
    </div>

    <script>
    function encodeImageFileAsURL(element) {
        let file = element.files[0];
        if (file) {
            let reader = new FileReader();
            reader.onloadend = function() {
                document.getElementById('qr_image_input').value = reader.result;
            }
            reader.readAsDataURL(file);
        }
    }
    </script>

</body>
</html>
