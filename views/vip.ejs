<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIP Levels - Bitgetpay</title>
    <style>
        body { font-family: sans-serif; background: #f4f7fc; margin: 0; padding-bottom: 70px; }
        .header { background: #0066ff; color: white; padding: 15px; text-align: center; font-size: 18px; font-weight: bold; }
        .vip-card { background: white; margin: 15px; padding: 15px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border-left: 5px solid #ff9900; }
        .vip-title { font-weight: bold; font-size: 16px; color: #333; display: flex; justify-content: space-between; }
        .vip-desc { font-size: 13px; color: #666; margin-top: 8px; line-height: 1.5; }
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: white; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #ddd; }
        .nav-item { text-align: center; text-decoration: none; color: #666; font-size: 11px; }
        .nav-item.active { color: #0066ff; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">VIP Investment Levels</div>

    <% vip_levels.forEach(vip => { %>
        <div class="vip-card">
            <div class="vip-title">
                <span><%= vip.level %></span>
                <span style="color: #0066ff;"><%= vip.price %> USDT</span>
            </div>
            <div class="vip-desc">
                📈 Daily Return: <b><%= vip.daily %> USDT/day</b><br>
                ⏳ Duration: <b><%= vip.days %> Days</b><br>
                ✨ <%= vip.desc %>
            </div>
        </div>
    <% }) %>

    <div class="bottom-nav">
        <a href="/" class="nav-item">🏠 Home</a>
        <a href="/deposit" class="nav-item">🔄 Deposit</a>
        <a href="/vip" class="nav-item active">⭐ VIP</a>
        <a href="/team" class="nav-item">📊 Team</a>
        <a href="/profile" class="nav-item">👤 Me</a>
    </div>
</body>
</html>
