<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VIP Levels - Bitget</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding-bottom: 70px; }
        .header { background: #1f1f1f; padding: 15px; text-align: center; font-size: 18px; font-weight: bold; border-bottom: 1px solid #333; }
        .card { background: #1f1f1f; margin: 15px; padding: 15px; border-radius: 12px; border: 1px solid #333; border-left: 5px solid #f0b90b; }
        .btn-invest { background: #f0b90b; color: black; border: none; padding: 10px 15px; border-radius: 6px; font-weight: bold; cursor: pointer; float: right; margin-top: -35px; }
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #1f1f1f; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #333; }
        .nav-item { text-align: center; text-decoration: none; color: #aaa; font-size: 11px; }
        .nav-item.active { color: #f0b90b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">VIP Investment Levels</div>

    <% if(success) { %> <div style="color: #00ffcc; text-align: center; margin: 10px;">VIP Level Subscribed Successfully!</div> <% } %>
    <% if(error) { %> <div style="color: #ff4d4d; text-align: center; margin: 10px;">Insufficient Balance! Please Deposit first.</div> <% } %>

    <% settings.vip_levels.forEach(vip => { %>
        <div class="card">
            <h3 style="margin: 0 0 10px 0; color: #f0b90b;"><%= vip.level %></h3>
            <p style="font-size: 13px; color: #aaa; margin: 4px 0;">Price: <b><%= vip.price %> USDT</b></p>
            <p style="font-size: 13px; color: #aaa; margin: 4px 0;">Daily Return: <b style="color: #00ffcc;"><%= vip.daily %> USDT/day</b></p>
            <p style="font-size: 13px; color: #aaa; margin: 4px 0;">Duration: <b><%= vip.days %> Days</b></p>
            
            <form action="/buy-vip" method="POST">
                <input type="hidden" name="level" value="<%= vip.level %>">
                <input type="hidden" name="price" value="<%= vip.price %>">
                <input type="hidden" name="daily" value="<%= vip.daily %>">
                <input type="hidden" name="days" value="<%= vip.days %>">
                <button type="submit" class="btn-invest">Invest Now</button>
            </form>
        </div>
    <% }) %>

    <div class="bottom-nav">
        <a href="/" class="nav-item">🏠 Home</a>
        <a href="/deposit" class="nav-item">🔄 Deposit</a>
        <a href="/vip" class="nav-item active">⭐ VIP</a>
        <a href="/team" class="nav-item">📊 Team</a>
        <a href="/profile" class="nav-item">👤 Me</a>
    </div>
</body>
</html>
