<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bitget - Home</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding: 20px; padding-bottom: 70px; }
        .card { background: #1f1f1f; padding: 20px; border-radius: 8px; border: 1px solid #333; max-width: 450px; margin: auto; margin-bottom: 15px; }
        .btn-primary { display: block; text-align: center; background: #f0b90b; color: black; padding: 12px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 10px; }
        .btn-success { display: block; text-align: center; background: #22c55e; color: white; padding: 12px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 10px; }
        /* Bottom Navbar Styling */
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #181818; border-top: 1px solid #333; display: flex; justify-content: space-around; padding: 10px 0; z-index: 1000; }
        .bottom-nav a { color: #aaa; text-decoration: none; font-size: 12px; text-align: center; }
        .bottom-nav a.active { color: #f0b90b; font-weight: bold; }
    </style>
</head>
<body>

    <div class="card">
        <h3>Bitget Dashboard</h3>
        <p style="color: #aaa; font-size: 14px;">Live USDT Rate</p>
        <h2 style="color: #f0b90b; margin-top: 5px;">1 USDT = ₹<%= settings.usdt_rate %></h2>
        <hr style="border: 0; border-top: 1px solid #333;">
        <p style="color: #aaa; font-size: 14px;">Total Balance</p>
        <h2 style="color: #00ffcc;"><%= user.balance.toFixed(2) %> USDT</h2>
        <p style="color: #aaa; font-size: 14px;">Team Commission</p>
        <h3 style="color: #38bdf8;"><%= user.team_commission.toFixed(2) %> USDT</h3>

        <a href="/deposit" class="btn-primary">Top Up / Deposit</a>
        <a href="/withdraw" class="btn-success">Withdrawal & Bank Card</a>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="bottom-nav">
        <a href="/" class="active">🏠<br>Home</a>
        <a href="/deposit">💳<br>Deposit</a>
        <a href="/withdraw">🏦<br>Withdraw</a>
        <a href="/vip">⭐<br>VIP</a>
        <a href="/team">📊<br>Team</a>
        <a href="/profile">👤<br>Me</a>
    </div>

</body>
</html>
