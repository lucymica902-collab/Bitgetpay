<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deposit USDT - Bitget</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding-bottom: 70px; }
        .header { background: #1f1f1f; padding: 15px; text-align: center; font-size: 18px; font-weight: bold; border-bottom: 1px solid #333; }
        .card { background: #1f1f1f; margin: 15px; padding: 20px; border-radius: 12px; border: 1px solid #333; text-align: center; }
        .qr-box { background: white; padding: 15px; display: inline-block; border-radius: 10px; margin: 10px 0; }
        .qr-box img { width: 180px; height: 180px; }
        .address-box { background: #2a2a2a; padding: 12px; border-radius: 8px; font-family: monospace; font-size: 13px; word-break: break-all; margin: 10px 0; color: #f0b90b; }
        input, button { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #444; border-radius: 8px; box-sizing: border-box; background: #2a2a2a; color: white; }
        button { background: #f0b90b; color: black; font-weight: bold; cursor: pointer; }
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #1f1f1f; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #333; }
        .nav-item { text-align: center; text-decoration: none; color: #aaa; font-size: 11px; }
        .nav-item.active { color: #f0b90b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">Deposit USDT to Bitget</div>

    <div class="card">
        <% if(success) { %> <div style="color: #00ffcc; margin-bottom: 10px;">Deposit submitted! Waiting for admin approval.</div> <% } %>
        
        <div class="qr-box">
            <!-- QR code generated for TRC20 address -->
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=<%= settings.trc_address %>" alt="QR Code">
        </div>

        <div style="text-align: left; font-size: 13px; color: #aaa;">Network: <b style="color: white;">TRC20 (Tron)</b></div>
        <div class="address-box"><%= settings.trc_address %></div>

        <form action="/submit-deposit" method="POST" enctype="multipart/form-data" style="text-align: left; margin-top: 15px;">
            <label>Amount (USDT)</label>
            <input type="number" step="0.01" name="amount" placeholder="Enter amount" required>
            
            <label>Transaction ID (TXID)</label>
            <input type="text" name="txid" placeholder="Enter TXID" required>
            
            <label>Upload Payment Screenshot</label>
            <input type="file" name="screenshot" accept="image/*" required>
            
            <button type="submit">Submit Deposit</button>
        </form>
    </div>

    <div class="bottom-nav">
        <a href="/" class="nav-item">🏠 Home</a>
        <a href="/deposit" class="nav-item active">🔄 Deposit</a>
        <a href="/vip" class="nav-item">⭐ VIP</a>
        <a href="/team" class="nav-item">📊 Team</a>
        <a href="/profile" class="nav-item">👤 Me</a>
    </div>
</body>
</html>
