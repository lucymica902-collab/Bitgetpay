<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - Bitget</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; margin: 0; padding-bottom: 70px; }
        .header { background: #1f1f1f; padding: 15px; text-align: center; font-size: 18px; font-weight: bold; border-bottom: 1px solid #333; }
        .card { background: #1f1f1f; margin: 15px; padding: 15px; border-radius: 12px; border: 1px solid #333; }
        .logout-btn { display: block; background: #ff4d4d; color: white; text-align: center; padding: 12px; border-radius: 8px; text-decoration: none; font-weight: bold; margin: 15px; }
        .support-btn { display: block; background: #0088cc; color: white; text-align: center; padding: 12px; border-radius: 8px; text-decoration: none; font-weight: bold; margin-top: 10px; }
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #1f1f1f; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #333; }
        .nav-item { text-align: center; text-decoration: none; color: #aaa; font-size: 11px; }
        .nav-item.active { color: #f0b90b; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">User Profile</div>

    <div class="card">
        <p>📱 Mobile Number: <b><%= user.phone %></b></p>
        <p>🔑 Referral Code / ID: <b style="color: #f0b90b;"><%= user.referral_code %></b></p>
    </div>

    <!-- Customer Support Section with @lucy9029 -->
    <div class="card" style="text-align: center;">
        <h3>Customer Support</h3>
        <p style="font-size: 12px; color: #aaa;">Kisi bhi samasya ke liye hamari support team se sampark karein.</p>
        <a href="https://t.me/lucy9029" target="_blank" class="support-btn">💬 Chat on Telegram (@lucy9029)</a>
    </div>

    <div class="card">
        <h3>Deposit History</h3>
        <% if(!user.deposit_history || user.deposit_history.length === 0) { %>
            <p style="font-size: 12px; color: #aaa;">No deposit history found.</p>
        <% } else { %>
            <% user.deposit_history.forEach(d => { %>
                <div style="font-size: 12px; border-bottom: 1px solid #333; padding: 6px 0;">
                    ➕ <b><%= d.amount %> USDT</b> - <%= d.date %>
                </div>
            <% }) %>
        <% } %>
    </div>

    <div class="card">
        <h3>VIP Level History</h3>
        <% if(!user.investments || user.investments.length === 0) { %>
            <p style="font-size: 12px; color: #aaa;">No active VIP investments.</p>
        <% } else { %>
            <% user.investments.forEach(inv => { %>
                <div style="font-size: 12px; border-bottom: 1px solid #333; padding: 6px 0;">
                    ⭐ <b><%= inv.level %></b> (<%= inv.price %> USDT) - Daily: <%= inv.daily %> USDT
                </div>
            <% }) %>
        <% } %>
    </div>

    <a href="/logout" class="logout-btn">Logout</a>

    <div class="bottom-nav">
        <a href="/" class="nav-item">🏠 Home</a>
        <a href="/deposit" class="nav-item">🔄 Deposit</a>
        <a href="/vip" class="nav-item">⭐ VIP</a>
        <a href="/team" class="nav-item">📊 Team</a>
        <a href="/profile" class="nav-item active">👤 Me</a>
    </div>
</body>
</html>
